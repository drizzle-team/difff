{
    "$schema": "./node_modules/wrangler/config-schema.json",
    // Static Astro build + a small Worker for Markdown share links (worker/index.ts).
    // Only /api/* and /md/* run the Worker; every other path is served straight from assets.
    "name": "difff",
    // Cloudflare account ID is not a secret; hardcoding it means CI only needs CLOUDFLARE_API_TOKEN.
    "account_id": "32ec5a45e61bb65267a5e522f2d1425d",
    "compatibility_date": "2026-11-12",
    "main": "./worker/index.ts",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/md/*"],
        // Serves /formatter/yaml from formatter/yaml.html (matches build.format: "file").
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
    },
    // Shared Markdown files, kept 24h. One-time setup:
    //   wrangler r2 bucket create difff-shares
    //   wrangler r2 bucket lifecycle add difff-shares expire-shares shares/ --expire-days 1
    // The Worker also rejects reads past `expiresAt`, so links stop working at exactly 24h
    // even though lifecycle deletion runs asynchronously.
    "r2_buckets": [
        {
            "binding": "SHARES",
            "bucket_name": "difff-shares",
            // `wrangler dev` uses the real bucket too (test shares expire like any other).
            "remote": true
        }
    ],
    // Per-IP limit on creating share links.
    "ratelimits": [
        {
            "name": "SHARE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 10,
                "period": 60
            }
        }
    ],
    "observability": {
        "enabled": true
    }
    // To serve difff.app from this Worker, detach the domain from the old Pages project, then add:
    // "routes": [{ "pattern": "difff.app", "custom_domain": true }]
}
