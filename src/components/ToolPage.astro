---
import { getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CodeMirror from "~/lib/shared/Codemirror/Codemirror.svelte";
import DoubleCodeMirror from "~/lib/shared/Codemirror/DoubleCodemirror.svelte";
import type { ToolPage } from "~/data/tools";

interface Props {
    page: ToolPage;
}

const { page } = Astro.props;
const { editor } = page;

const entry = page.article ? await getEntry("tools", page.article) : undefined;
if (page.article && !entry) throw new Error(`Missing article "${page.article}" for ${page.path}`);
const Content = entry ? (await render(entry)).Content : null;
---

<BaseLayout title={page.title} description={page.description}>
    <a href="/changelog">
        <header class="header">
            <div class="container">
                <p class="header-text">
                    🚀 Visit and see how our service has changed over the past week →
                </p>
            </div>
        </header>
    </a>

    <div class="container">
        <main class="main">
            <header>
                <h1 class="main_title">{page.heading}</h1>
                <h2 class="main_subtitle">{page.subheading}</h2>
            </header>
            <section class="field-wrapper">
                {editor.kind === "single" ? (
                    <CodeMirror
                        client:load
                        tool={editor.tool}
                        format={editor.format}
                        placeholder={editor.placeholder}
                        label={editor.label}
                    />
                ) : (
                    <DoubleCodeMirror
                        client:load
                        formatLeft={editor.formatLeft}
                        placeholderLeft={editor.placeholderLeft}
                        labelLeft={editor.labelLeft}
                        formatRight={editor.formatRight}
                        placeholderRight={editor.placeholderRight}
                        labelRight={editor.labelRight}
                        convert={editor.convert}
                    />
                )}
            </section>
            {Content && (
                <article>
                    <Content />
                </article>
            )}
        </main>
    </div>
</BaseLayout>

<style>
    .header {
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0 16px;
        height: 40px;
        border-bottom: 1px solid #2c2c2c;
        font-family: "NotoSans-Regular", sans-serif;
        color: #e2e8f0;
    }

    .header-text {
        text-align: center;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        line-clamp: 1;
        -webkit-box-orient: vertical;
        text-overflow: ellipsis;
    }

    .main {
        margin: 0 auto;
        display: flex;
        align-items: center;
        flex-direction: column;
    }

    .field-wrapper {
        display: flex;
        flex-direction: column;
        margin: 32px 0 0;
        width: 100%;
    }
</style>
