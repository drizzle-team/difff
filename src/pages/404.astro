---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout
    title="Page not found | Difff"
    description="The page you are looking for does not exist."
>
    <div class="container">
        <main class="main">
            <h1 class="main_title">404 — Page not found</h1>
            <h2 class="main_subtitle">
                <a href="/">Back to the JSON formatter</a>
            </h2>
        </main>
    </div>
</BaseLayout>

<style>
    .main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        padding: 64px 0;
    }
</style>
