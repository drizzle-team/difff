{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "env": {
        "builtin": true,
        "browser": true,
        "node": true
    },
    "ignorePatterns": ["dist/", ".astro/", ".wrangler/", "node_modules/"]
}
